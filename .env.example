# Clave de la API de Anthropic (también vale `ant auth login`)
ANTHROPIC_API_KEY=
# Modelo del LLM (por defecto claude-opus-5-5)
LLM_MODEL=claude-opus-5-5
# Tipos de referencia si fallan FRED / BCE (en %)
FALLBACK_FED_RATE=4.25
FALLBACK_ECB_RATE=2.00
# Ruta de la base de datos SQLite
DB_PATH=portfolio.db
# Telegram: crea el bot con @BotFather y obtén tu chat_id escribiéndole al bot y abriendo
# https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Watchlist del servicio continuo (por defecto watchlist.json junto al código)
# WATCHLIST_PATH=watchlist.json
